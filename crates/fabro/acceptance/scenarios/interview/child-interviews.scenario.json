{
  "schema_version": 1,
  "id": "interview/child-interviews",
  "family": "interview",
  "title": "A parent gate answered by the script, then the pinned interview workflow runs as a nested child whose five questions are answered under the child's invocation path, and the child's answers reach the parent's final context. The pinned bundle has no parent, so the parent graph is inline and calls the bundle's workflow.",
  "obligation": "interview/child-interviews",
  "bundle": {
    "inline": "graphs/child-interviews.fabro",
    "with_bundle": "interview",
    "with_hash": "6c52182c0e4e906ba042a7cbcd35c73a0b37ff94d58e33db6572e1e27c749972"
  },
  "inputs": {},
  "fixture": {
    "commits": [
      {
        "message": "fixture",
        "write": {
          "README.md": {
            "text": "fixture\n"
          }
        }
      }
    ],
    "settings": "[run.model]\nprovider = \"openai\"\nname = \"{model}\"\n"
  },
  "modes": {
    "backend": "host",
    "agent": "api:openai"
  },
  "services": {
    "openai": [
      {
        "scenario_id": "summary",
        "matcher": {
          "input_contains": "Summarize the full human interview"
        },
        "script": {
          "kind": "success",
          "response_text": "Child summary."
        }
      }
    ]
  },
  "interviews": [
    {
      "id": "parent",
      "match": {
        "node": "pre",
        "invocation_path": "/"
      },
      "action": {
        "kind": "choice",
        "value": "Y"
      }
    },
    {
      "id": "c-easy",
      "match": {
        "node": "yes_no",
        "invocation_path": "/child"
      },
      "action": {
        "kind": "choice",
        "value": "Y"
      }
    },
    {
      "id": "c-go",
      "match": {
        "node": "confirmation",
        "invocation_path": "/child"
      },
      "action": {
        "kind": "choice",
        "value": "Y"
      }
    },
    {
      "id": "c-goals",
      "match": {
        "node": "multiple_choice",
        "invocation_path": "/child"
      },
      "action": {
        "kind": "choice",
        "value": "G"
      }
    },
    {
      "id": "c-success",
      "match": {
        "node": "multi_select",
        "invocation_path": "/child"
      },
      "action": {
        "kind": "choices",
        "values": [
          "S"
        ]
      }
    },
    {
      "id": "c-text",
      "match": {
        "node": "freeform",
        "invocation_path": "/child"
      },
      "action": {
        "kind": "text",
        "value": "from the child"
      }
    }
  ],
  "controls": {},
  "bounds": {
    "deadline_ms": 120000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "pre",
        "child",
        "post"
      ],
      "forbidden_nodes": [],
      "visits": {
        "pre": 1,
        "child": 1,
        "post": 1
      }
    },
    "context": {
      "exact": {
        "human.gate.pre.answer": "yes",
        "human.gate.freeform.answer": "from the child",
        "human.gate.yes_no.answer": "yes",
        "response.summarize": "Child summary.",
        "human.gate.label": "from the child"
      },
      "absent": [],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "post.txt",
        "text": "done\n"
      }
    ],
    "side_effects": {
      "git": [],
      "http": []
    },
    "providers": {
      "openai": {
        "consumed": [
          "summary"
        ],
        "unmatched": 0,
        "requests": 1,
        "contains": [
          {
            "request": 0,
            "text": "from the child"
          }
        ]
      }
    },
    "interviews": {
      "questions": [
        {
          "node": "pre",
          "invocation_path": "/",
          "delivery": "delivered"
        },
        {
          "node": "yes_no",
          "invocation_path": "/child",
          "delivery": "delivered"
        },
        {
          "node": "confirmation",
          "invocation_path": "/child",
          "delivery": "delivered"
        },
        {
          "node": "multiple_choice",
          "invocation_path": "/child",
          "delivery": "delivered"
        },
        {
          "node": "multi_select",
          "invocation_path": "/child",
          "delivery": "delivered"
        },
        {
          "node": "freeform",
          "invocation_path": "/child",
          "delivery": "delivered",
          "reply": {
            "$subset": {
              "text": "from the child"
            }
          }
        }
      ],
      "errors": [],
      "consumed": {
        "parent": 1,
        "c-easy": 1,
        "c-go": 1,
        "c-goals": 1,
        "c-success": 1,
        "c-text": 1
      },
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
