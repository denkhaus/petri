digraph ChildInterviews {
    graph [goal="A parent gate, then the pinned interview workflow as a child whose answers reach the parent"]
    start [shape=Mdiamond]
    exit [shape=Msquare]
    pre [shape=hexagon, label="Run the child interview?", question_type="yes_no"]
    child [shape=house, label="Interview", stack.child_workflow="fabro/workflows/interview/workflow.fabro", manager.max_cycles=100, manager.poll_interval="1s"]
    post [shape=parallelogram, script="echo done > post.txt && cat post.txt"]
    start -> pre
    pre -> child [label="[Y] Yes"]
    pre -> exit [label="[N] No"]
    child -> post -> exit
}
