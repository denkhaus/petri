{
  "schema_version": 1,
  "id": "interview/timeout-cancel",
  "family": "interview",
  "title": "The run is cancelled from the terminal while a gate waits for an answer no one gives: the run ends cancelled, the waiting question is recorded, no later gate or model call happens, and the workspace and receipt are retained.",
  "obligation": "interview/timeout-cancel",
  "bundle": {
    "id": "interview",
    "hash": "6c52182c0e4e906ba042a7cbcd35c73a0b37ff94d58e33db6572e1e27c749972"
  },
  "inputs": {},
  "fixture": {
    "commits": [
      {
        "message": "interview fixture",
        "write": {
          "README.md": {
            "text": "interview fixture\n"
          }
        }
      }
    ],
    "settings": "[run.model]\nprovider = \"openai\"\nname = \"{model}\"\n"
  },
  "modes": {
    "backend": "host",
    "agent": "api:openai"
  },
  "services": {},
  "interviews": [
    {
      "id": "easy",
      "match": {
        "node": "yes_no"
      },
      "action": {
        "kind": "choice",
        "value": "Y"
      }
    },
    {
      "id": "never",
      "match": {
        "node": "confirmation"
      },
      "action": {
        "kind": "withhold"
      }
    }
  ],
  "controls": {
    "interrupt_when": {
      "stderr": "waiting for an answer: Confirm that you want to continue"
    }
  },
  "bounds": {
    "deadline_ms": 120000
  },
  "expect": {
    "process": {
      "exit_code": 1,
      "status": "cancelled",
      "required_nodes": [
        "yes_no"
      ],
      "forbidden_nodes": [
        "multiple_choice",
        "multi_select",
        "freeform",
        "summarize"
      ],
      "visits": {
        "yes_no": 1
      }
    },
    "context": {
      "exact": {
        "human.gate.yes_no.answer": "yes"
      },
      "absent": [
        "human.gate.confirmation.answer",
        "response.summarize"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [],
    "side_effects": {
      "git": [],
      "http": []
    },
    "providers": {
      "openai": {
        "consumed": [],
        "unmatched": 0,
        "requests": 0
      }
    },
    "interviews": {
      "questions": [
        {
          "node": "yes_no",
          "kind": "yes_no",
          "delivery": "delivered",
          "reply": {
            "$subset": {
              "choice": "Y"
            }
          }
        },
        {
          "node": "confirmation",
          "kind": "confirmation",
          "delivery": {
            "$any": true
          }
        }
      ],
      "errors": [],
      "consumed": {
        "easy": 1,
        "never": 1
      },
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true,
      "no_requests_after_cancel": true,
      "cancel_reason": "interrupt"
    }
  }
}
