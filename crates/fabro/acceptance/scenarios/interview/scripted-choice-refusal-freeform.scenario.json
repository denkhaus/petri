{
  "schema_version": 1,
  "id": "interview/scripted-choice-refusal-freeform",
  "family": "interview",
  "title": "Every question type of the pinned interview workflow answered by a script: a choice, a refusal, a multiple choice, a multi-select, free text, then the summary prompt.",
  "obligation": "interview/scripted-choice-refusal-freeform",
  "bundle": { "id": "interview", "hash": "6c52182c0e4e906ba042a7cbcd35c73a0b37ff94d58e33db6572e1e27c749972" },
  "inputs": {},
  "fixture": {
    "commits": [ { "message": "interview fixture", "write": { "README.md": { "text": "interview fixture\n" } } } ],
    "settings": "[run.model]\nprovider = \"openai\"\nname = \"{model}\"\n"
  },
  "modes": { "backend": "host", "agent": "api:openai" },
  "services": {
    "openai": [
      {
        "scenario_id": "summary",
        "matcher": { "input_contains": "Summarize the full human interview" },
        "script": { "kind": "success", "response_text": "Summary: the user finds the interview easy, stops after this, centers risks, emphasizes blockers and next steps, and wants to ship on Friday." }
      }
    ]
  },
  "interviews": [
    { "id": "easy", "match": { "node": "yes_no", "kind": "yes_no", "options": ["Y", "N"] }, "action": { "kind": "choice", "value": "Y" } },
    { "id": "stop-here", "match": { "node": "confirmation", "kind": "confirmation" }, "action": { "kind": "negative" } },
    { "id": "risks", "match": { "node": "multiple_choice", "kind": "multiple_choice", "options": ["G", "R", "T", "Q"] }, "action": { "kind": "choice", "value": "Risks" } },
    { "id": "blockers-and-next", "match": { "node": "multi_select", "kind": "multi_select" }, "action": { "kind": "choices", "values": ["B", "N"] } },
    { "id": "friday", "match": { "node": "freeform", "kind": "freeform", "freeform": true }, "action": { "kind": "text", "value": "ship on Friday" } }
  ],
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": ["yes_no", "confirmation", "multiple_choice", "multi_select", "freeform", "summarize"],
      "forbidden_nodes": [],
      "visits": { "yes_no": 1, "confirmation": 1, "multiple_choice": 1, "multi_select": 1, "freeform": 1, "summarize": 1 }
    },
    "context": {
      "exact": {
        "human.gate.yes_no.answer": "Y",
        "human.gate.confirmation.answer": "N",
        "human.gate.multiple_choice.answer": "R",
        "human.gate.multi_select.answer": "B, N",
        "human.gate.freeform.answer": "ship on Friday",
        "human.gate.yes_no.question": "Is this interview workflow easy to follow so far?",
        "human.gate.freeform.question": "Add any final context, constraints, or nuance for the summary.",
        "response.summarize": "Summary: the user finds the interview easy, stops after this, centers risks, emphasizes blockers and next steps, and wants to ship on Friday.",
        "last_stage": "summarize"
      },
      "absent": ["output.summarize", "parallel.results"],
      "extra_allowed": [],
      "complete": false
    },
    "files": [],
    "side_effects": { "git": [], "http": [] },
    "providers": {
      "openai": {
        "consumed": ["summary"],
        "unmatched": 0,
        "requests": 1,
        "model": "{model}",
        "contains": [
          { "request": 0, "text": "ship on Friday" },
          { "request": 0, "text": "Risks" }
        ]
      }
    },
    "interviews": {
      "questions": [
        { "node": "yes_no", "kind": "yes_no", "delivery": "delivered", "reply": { "$subset": { "choice": "Y" } }, "invocation_path": "/", "ask": 1 },
        { "node": "confirmation", "kind": "confirmation", "delivery": "delivered", "reply": { "$subset": { "choice": "N" } }, "invocation_path": "/", "ask": 1 },
        { "node": "multiple_choice", "kind": "multiple_choice", "delivery": "delivered", "reply": { "$subset": { "choice": "R" } }, "invocation_path": "/", "ask": 1 },
        { "node": "multi_select", "kind": "multi_select", "delivery": "delivered", "reply": { "$subset": { "choice": "B" } }, "invocation_path": "/", "ask": 1 },
        { "node": "freeform", "kind": "freeform", "delivery": "delivered", "reply": { "$subset": { "text": "ship on Friday" } }, "invocation_path": "/", "ask": 1 }
      ],
      "errors": [],
      "consumed": { "easy": 1, "stop-here": 1, "risks": 1, "blockers-and-next": 1, "friday": 1 },
      "no_plaintext": []
    },
    "lifecycle": { "no_leaked_processes": true, "retained_workspace": true }
  }
}
