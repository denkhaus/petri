{
  "schema_version": 1,
  "id": "routing/bundle-defaults-and-overrides",
  "family": "routing",
  "title": "The code-review bundle's own configuration supplies the defaults: `effort` comes from `[run.inputs]` in workflow.toml, `--input model` overrides the stylesheet's model on the wire, and the finder prompt's `{% include %}` partials reach the request.",
  "obligation": "code-review/bundle-configuration",
  "bundle": {
    "id": "code-review",
    "hash": "c43a461a05b2962cedd95b165430e3a21942ce8517a8e9d26024ed9ff4f22e8a"
  },
  "inputs": {
    "mode": "changes",
    "range": "{commit:0}..{commit:1}",
    "model": "kimi-k3",
    "expected_min_findings": "1"
  },
  "fixture": {
    "commits": [
      {
        "message": "base",
        "write": {
          ".gitignore": {
            "text": "__pycache__/\n*.pyc\n"
          },
          "src/app.py": {
            "file": "../code-review/fixtures/app-base.py"
          },
          "AGENTS.md": {
            "file": "../code-review/fixtures/AGENTS.md"
          }
        }
      },
      {
        "message": "change the pager",
        "write": {
          "src/app.py": {
            "file": "../code-review/fixtures/app-after.py"
          }
        }
      }
    ],
    "python_modules": [
      "yaml"
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "local-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:local:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 10, \"end_line\": 10, \"summary\": \"page_count drops the final partial page.\", \"short_summary\": \"Final partial page dropped\", \"failure_scenario\": \"7 items at page size 3 report 2 pages.\", \"category\": \"correctness\", \"issue_type\": \"bug\", \"severity\": \"HIGH\", \"confidence\": \"HIGH\"}]}",
          "usage": {
            "input_tokens": 10,
            "output_tokens": 5
          }
        }
      },
      {
        "scenario_id": "rule-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:rule:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": []}",
          "usage": {
            "input_tokens": 10,
            "output_tokens": 5
          }
        }
      },
      {
        "scenario_id": "verify-pages",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F1\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"CONFIRMED\", \"reasoning\": \"src/app.py:10 uses floor division.\"}",
          "usage": {
            "input_tokens": 10,
            "output_tokens": 5
          }
        }
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 180000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "prepare",
        "plan_finders",
        "finders",
        "finder",
        "merge_finders",
        "plan_verify",
        "verify",
        "verifier",
        "tally",
        "final_tally",
        "render_report",
        "verify_expectations",
        "publish_pr"
      ],
      "forbidden_nodes": [
        "grouping",
        "sweeper"
      ],
      "visits": {
        "finder": 2,
        "verifier": 1
      }
    },
    "context": {
      "exact": {
        "effort": "medium",
        "mode": "changes",
        "use_planner": true,
        "use_grouping": false,
        "reported_count": 1,
        "finding_count": 1,
        "report_expectations_checked": true,
        "expected_min_findings": 1,
        "publish_pr": {
          "requested": false
        }
      },
      "absent": [
        "output.finder"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "CODE-REVIEW-*/metadata/review-meta.json",
        "json": {
          "$subset": {
            "effort": "medium",
            "model": "kimi-k3",
            "mode": "changes"
          }
        }
      },
      {
        "path": "CODE-REVIEW-*/evidence/findings.json",
        "json": [
          {
            "$subset": {
              "id": "R1",
              "line": 10
            }
          }
        ]
      }
    ],
    "side_effects": {
      "git": [],
      "http": []
    },
    "providers": {
      "openrouter": {
        "consumed": {
          "$set": [
            "local-finder",
            "rule-finder",
            "verify-pages"
          ]
        },
        "unmatched": 0,
        "requests": 3,
        "model": "kimi-k3",
        "contains": [
          {
            "request": 0,
            "text": "read-only"
          },
          {
            "request": 0,
            "text": "finding"
          }
        ]
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
