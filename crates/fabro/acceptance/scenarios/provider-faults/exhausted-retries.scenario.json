{
  "schema_version": 1,
  "id": "provider-faults/exhausted-retries",
  "family": "provider-faults",
  "title": "Every attempt meets a server error until the retries are spent: the stage fails with the server class, no tool runs, and the run stops without a partial edit.",
  "obligation": null,
  "bundle": {
    "inline": "graphs/edit-and-verify.fabro"
  },
  "inputs": {},
  "fixture": {
    "commits": [
      {
        "message": "fixture",
        "write": {
          "README.md": {
            "text": "fixture\n"
          }
        }
      }
    ],
    "settings": "[run.model]\nprovider = \"anthropic\"\nname = \"{model}\"\n[run.model.controls]\nreasoning_effort = \"high\"\n"
  },
  "modes": {
    "backend": "host",
    "agent": "api:anthropic"
  },
  "services": {
    "anthropic": [
      {
        "scenario_id": "always-down",
        "matcher": {
          "input_contains": "Append the word reviewed"
        },
        "script": {
          "kind": "error",
          "status": 503,
          "error_type": "api_error",
          "code": "service_unavailable",
          "message": "the fixture is down"
        },
        "repeat": 8
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 120000
  },
  "expect": {
    "process": {
      "exit_code": 1,
      "status": "failed",
      "required_nodes": [
        "prepare",
        "agent"
      ],
      "forbidden_nodes": [
        "verify"
      ],
      "visits": {
        "agent": 1
      }
    },
    "context": {
      "exact": {
        "failure_class": "llm:server"
      },
      "absent": [
        "response.agent"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "notes.txt",
        "text": "draft\n"
      }
    ],
    "side_effects": {
      "git": [],
      "http": []
    },
    "providers": {
      "anthropic": {
        "consumed": {
          "$contains": "always-down"
        },
        "unmatched": 0
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": [
        "{credential}"
      ]
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
