digraph EditAndVerify {
    graph [goal="Append a line through the model's shell tool, then verify it"]
    rankdir=LR
    start [shape=Mdiamond]
    exit [shape=Msquare]
    prepare [shape=parallelogram, script="printf 'draft\n' > notes.txt && echo prepared"]
    agent [label="Edit the notes", prompt="Append the word reviewed to notes.txt, then read it back and say APPENDED.", on_failure="exit"]
    verify [shape=parallelogram, script="cat notes.txt"]
    start -> prepare -> agent -> verify -> exit
}
