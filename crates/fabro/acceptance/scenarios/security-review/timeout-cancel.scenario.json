{
  "schema_version": 1,
  "id": "security-review/timeout-cancel",
  "family": "security-review",
  "title": "The research request never answers and the run is cancelled from the terminal: the run ends cancelled, no further model request is made, the workspace is retained, and no report bundle is published from an unfinished scan.",
  "obligation": "security-review/timeout-cancel",
  "bundle": {
    "id": "security-review",
    "hash": "4b17685a5612fb37e5cdd53c9526793342a562caf5afce36f7d895c4eebba555"
  },
  "inputs": {
    "mode": "scan",
    "effort": "low",
    "scope": "src/service.py"
  },
  "fixture": {
    "commits": [
      {
        "message": "the service under scan",
        "write": {
          "src/service.py": {
            "file": "fixtures/vulnerable_service.py"
          },
          "src/clean.py": {
            "file": "fixtures/clean_service.py"
          }
        }
      }
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "research-hangs",
        "matcher": {
          "input_contains": "\"job_id\": \"research:001-repository-e2885f2b:all\""
        },
        "script": {
          "kind": "hang"
        }
      }
    ]
  },
  "interviews": [],
  "controls": {
    "interrupt_when": {
      "request": "research-hangs"
    }
  },
  "bounds": {
    "deadline_ms": 120000
  },
  "expect": {
    "process": {
      "exit_code": 1,
      "status": "cancelled",
      "required_nodes": [
        "prepare",
        "plan_matrix"
      ],
      "forbidden_nodes": [
        "final_tally",
        "render_report",
        "verify_expectations"
      ],
      "visits": {}
    },
    "context": {
      "exact": {
        "run_research": true
      },
      "absent": [
        "kept_count",
        "finding_count",
        "report_path"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "SECURITY-REVIEW-*/evidence/findings.json",
        "absent": true
      },
      {
        "path": ".fabro/workflows/security-review/runtime/state.json",
        "json": {
          "$subset": {
            "mode": "scan"
          }
        }
      }
    ],
    "side_effects": {
      "git": [
        {
          "repo": "workspace",
          "ref": "HEAD",
          "is": "{commit:0}"
        }
      ],
      "http": []
    },
    "providers": {
      "openrouter": {
        "consumed": [
          "research-hangs"
        ],
        "unmatched": 0,
        "requests": 1
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true,
      "no_requests_after_cancel": true,
      "cancel_reason": "interrupt"
    }
  }
}
