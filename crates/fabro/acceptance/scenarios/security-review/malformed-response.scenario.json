{
  "schema_version": 1,
  "id": "security-review/malformed-response",
  "family": "security-review",
  "title": "The research pass answers prose that misses the findings schema on its first try and on both repair turns: the branch fails under on_failure=succeed, the scan records an invalid research result, and the report is empty rather than wrong.",
  "obligation": "security-review/malformed-response",
  "bundle": {
    "id": "security-review",
    "hash": "4b17685a5612fb37e5cdd53c9526793342a562caf5afce36f7d895c4eebba555"
  },
  "inputs": {
    "mode": "scan",
    "effort": "low",
    "scope": "src/service.py"
  },
  "fixture": {
    "commits": [
      {
        "message": "the service under scan",
        "write": {
          "src/service.py": {
            "file": "fixtures/vulnerable_service.py"
          },
          "src/clean.py": {
            "file": "fixtures/clean_service.py"
          }
        }
      }
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "research-bad",
        "matcher": {
          "input_contains": "\"job_id\": \"research:001-repository-e2885f2b:all\""
        },
        "script": {
          "kind": "success",
          "response_text": "I read the file and it looks risky, but I will describe it in prose instead."
        },
        "repeat": 3
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 180000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "prepare",
        "plan_matrix",
        "research",
        "researcher",
        "merge_research",
        "dedup_rank",
        "tally",
        "final_tally",
        "render_report"
      ],
      "forbidden_nodes": [
        "panel_verifier",
        "inventory"
      ],
      "visits": {
        "researcher": 1
      }
    },
    "context": {
      "exact": {
        "research_results_merged": 0,
        "run_panel": false,
        "kept_count": 0,
        "finding_count": 0
      },
      "absent": [
        "output.researcher",
        "verification_jobs"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "SECURITY-REVIEW-*/evidence/findings.json",
        "json": []
      },
      {
        "path": "SECURITY-REVIEW-*/evidence/coverage.json",
        "json": {
          "$subset": {
            "invalidResearchResults": {
              "$len": 1
            }
          }
        }
      }
    ],
    "side_effects": {
      "git": [
        {
          "repo": "workspace",
          "ref": "HEAD",
          "is": "{commit:0}"
        }
      ],
      "http": []
    },
    "providers": {
      "openrouter": {
        "consumed": {
          "$len": 3
        },
        "unmatched": 0,
        "requests": 3
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
