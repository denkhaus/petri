          "input_contains": "\"job_id\": \"panel:F1:reachability\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"TRUE_POSITIVE\", \"reasoning\": \"src/service.py:12 passes the query parameter to os.system with no allowlist.\"}"
        }
      },
      {
        "scenario_id": "panel-F1-impact",
        "matcher": {
          "input_contains": "\"job_id\": \"panel:F1:impact\""
