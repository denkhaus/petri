{
  "schema_version": 1,
  "id": "code-review/findings-in-multiple-branches",
  "family": "code-review",
  "title": "At the medium tier two finder branches (the local-correctness job and the rule-audit cell) each report one finding at a distinct location; both survive verification in two verifier branches; the report lists exactly the two with nothing dropped or duplicated.",
  "obligation": "code-review/findings-in-multiple-branches",
  "bundle": {
    "id": "code-review",
    "hash": "c43a461a05b2962cedd95b165430e3a21942ce8517a8e9d26024ed9ff4f22e8a"
  },
  "inputs": {
    "mode": "changes",
    "effort": "medium",
    "model": "kimi-k3",
    "range": "{commit:0}..{commit:1}",
    "expected_min_findings": "2"
  },
  "fixture": {
    "commits": [
      {
        "message": "base",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-base.py"
          },
          "AGENTS.md": {
            "file": "fixtures/AGENTS.md"
          },
          ".gitignore": {
            "text": "__pycache__/\n*.pyc\n"
          }
        }
      },
      {
        "message": "change the pager and the title escaping",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-after.py"
          }
        }
      }
    ],
    "python_modules": [
      "yaml"
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "local-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:local:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 10, \"end_line\": 10, \"summary\": \"page_count drops the final partial page: floor division discards the remainder.\", \"short_summary\": \"Final partial page dropped\", \"failure_scenario\": \"7 items at page size 3 report 2 pages, so item 7 is unreachable.\", \"category\": \"correctness\", \"issue_type\": \"bug\", \"severity\": \"HIGH\", \"confidence\": \"HIGH\"}]}"
        }
      },
      {
        "scenario_id": "rule-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:rule:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 15, \"end_line\": 15, \"summary\": \"render_title escapes the title twice.\", \"short_summary\": \"Title escaped twice\", \"failure_scenario\": \"A title containing & renders as &amp;amp;.\", \"category\": \"conventions\", \"issue_type\": \"style\", \"severity\": \"LOW\", \"confidence\": \"MEDIUM\", \"rule_id\": \"builtin:repository.instructions/agents-md-conventions\"}]}"
        }
      },
      {
        "scenario_id": "verify-pages",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F1\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"CONFIRMED\", \"reasoning\": \"src/app.py:10 uses floor division; 7 items at page size 3 report 2 pages.\"}"
        }
      },
      {
        "scenario_id": "verify-escape",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F2\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"PLAUSIBLE\", \"reasoning\": \"src/app.py:14-15 escapes twice; & renders as &amp;amp;.\"}"
        }
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 180000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "prepare",
        "plan_finders",
        "finders",
        "finder",
        "finder_join",
        "merge_finders",
        "plan_verify",
        "verify",
        "verifier",
        "verify_join",
        "merge_verify",
        "tally",
        "final_tally",
        "render_report",
        "verify_expectations",
        "publish_pr"
      ],
      "forbidden_nodes": [
        "grouping",
        "sweeper",
        "merge_grouping",
        "sweep_verify"
      ],
      "visits": {
        "finder": 2,
        "verifier": 2,
        "prepare": 1
      }
    },
    "context": {
      "exact": {
        "empty_target": false,
        "mode": "changes",
        "effort": "medium",
        "products_dir": {
          "$regex": "^CODE-REVIEW-\\d{8}-\\d{6}(-\\d+)?$"
        },
        "use_planner": true,
        "use_grouping": false,
        "finder_jobs": {
          "$len": 2
        },
        "finders_results_merged": 2,
        "run_verify": true,
        "verify_jobs": {
          "$len": 2
        },
        "verify_results_merged": 2,
        "run_sweep": false,
        "reported_count": 2,
        "finding_count": 2,
        "canonical_bundle_written": true,
        "report_expectations_checked": true,
        "expected_min_findings": 2,
        "parallel.results": [],
        "publish_pr": {
          "requested": false
        }
      },
      "absent": [
        "output.finder",
        "output.verifier",
        "finder_jobs_failed"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "CODE-REVIEW-*/evidence/findings.json",
        "json": [
          {
            "$subset": {
              "id": "R1",
              "file": "src/app.py",
              "line": 10,
              "location": {
                "$subset": {
                  "start_line": 10,
                  "end_line": 10,
                  "existing_code": "    return len(items) // page_size"
                }
              },
              "category": "correctness",
              "issue_type": "bug",
              "severity": "HIGH",
              "confidence": "HIGH",
              "verdict": "CONFIRMED",
              "reporters": [
                "finder:local:01"
              ],
              "rule_ids": [],
              "short_summary": "Final partial page dropped"
            }
          },
          {
            "$subset": {
              "id": "R2",
              "file": "src/app.py",
              "line": 15,
              "category": "conventions",
              "issue_type": "style",
              "severity": "LOW",
              "verdict": "PLAUSIBLE",
              "reporters": [
                "finder:rule:01"
              ],
              "rule_ids": [
                "builtin:repository.instructions/agents-md-conventions"
              ],
              "short_summary": "Title escaped twice"
            }
          }
        ]
      },
      {
        "path": "CODE-REVIEW-*/evidence/review-manifest.json",
        "json": {
          "$subset": {
            "mode": "changes",
            "effort": "medium",
            "model": "kimi-k3",
            "counts": {
              "deduplicated": 2,
              "duplicates": 0,
              "kept": 2,
              "raw": 2,
              "reported": 2,
              "sweep": 0
            },
            "completion": {
              "status": "complete"
            },
            "verification": {
              "status": "complete"
            }
          }
        }
      },
      {
        "path": "CODE-REVIEW-*/CODE-REVIEW-RESULTS.md",
        "contains": [
          "Final partial page dropped",
          "Title escaped twice"
        ]
      },
      {
        "path": "CODE-REVIEW-*/CODE-REVIEW-RESULTS.jsonl",
        "lines": 2
      },
      {
        "path": "CODE-REVIEW-*/CODE-REVIEW-RESULTS.sarif",
        "contains": [
          "\"level\": \"error\"",
          "\"level\": \"note\""
        ]
      },
      {
        "path": "CODE-REVIEW-*/evidence/coverage.json",
        "json": {
          "$subset": {
