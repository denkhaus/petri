            "filteredFindingReports": [],
            "finders": {
              "$subset": {
                "dispatched": 2,
                "returned": 2,
                "invalid": []
              }
            }
          }
        }
      },
      {
        "path": "src/app.py",
        "file": "fixtures/app-after.py"
      }
    ],
    "side_effects": {
      "git": [
        {
          "repo": "workspace",
          "ref": "HEAD",
          "is": "{commit:1}"
        }
      ],
      "http": []
