        "consumed": {
          "$set": [
            "local-finder",
            "rule-finder",
            "verify-pages",
            "verify-escape"
          ]
        },
        "unmatched": 0,
        "requests": 4,
        "model": "{model}",
        "effort": "high"
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
