{
  "schema_version": 1,
  "id": "code-review/repair-exhausted",
  "family": "code-review",
  "title": "The local-correctness finder answers prose on its first try and on both repair turns, so its output contract is exhausted and the branch fails under on_failure=succeed; the review completes as partial with the rule-audit finding alone, and the failed job is recorded as invalid.",
  "obligation": "code-review/repair-exhausted",
  "bundle": {
    "id": "code-review",
    "hash": "c43a461a05b2962cedd95b165430e3a21942ce8517a8e9d26024ed9ff4f22e8a"
  },
  "inputs": {
    "mode": "changes",
    "effort": "medium",
    "model": "kimi-k3",
    "range": "{commit:0}..{commit:1}",
    "expected_min_findings": "1"
  },
  "fixture": {
    "commits": [
      {
        "message": "base",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-base.py"
          },
          "AGENTS.md": {
            "file": "fixtures/AGENTS.md"
          }
        }
      },
      {
        "message": "change the pager and the title escaping",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-after.py"
          }
        }
      }
    ],
    "python_modules": [
      "yaml"
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "local-finder-bad",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:local:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "still prose, no findings object here"
        },
        "repeat": 3
      },
      {
        "scenario_id": "rule-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:rule:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 15, \"end_line\": 15, \"summary\": \"render_title escapes the title twice.\", \"short_summary\": \"Title escaped twice\", \"failure_scenario\": \"A title containing & renders as &amp;amp;.\", \"category\": \"conventions\", \"issue_type\": \"style\", \"severity\": \"LOW\", \"confidence\": \"MEDIUM\", \"rule_id\": \"builtin:repository.instructions/agents-md-conventions\"}]}"
        }
      },
      {
        "scenario_id": "verify-escape",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F1\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"PLAUSIBLE\", \"reasoning\": \"src/app.py:14-15 escapes twice.\"}"
        }
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 180000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "prepare",
        "plan_finders",
        "finders",
        "finder",
        "finder_join",
        "merge_finders",
        "plan_verify",
        "verify",
        "verifier",
        "verify_join",
        "merge_verify",
        "tally",
        "final_tally",
        "render_report",
        "verify_expectations",
        "publish_pr"
      ],
      "forbidden_nodes": [
        "grouping",
        "sweeper"
      ],
      "visits": {
        "finder": 2,
        "verifier": 1
      }
    },
    "context": {
      "exact": {
        "finders_results_merged": 1,
        "reported_count": 1,
        "finding_count": 1,
        "report_expectations_checked": true
      },
      "absent": [
        "output.finder"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "CODE-REVIEW-*/evidence/findings.json",
        "json": [
          {
            "$subset": {
              "id": "R1",
              "line": 15,
              "category": "conventions",
              "reporters": [
                "finder:rule:01"
              ]
            }
          }
        ]
      },
      {
        "path": "CODE-REVIEW-*/evidence/review-manifest.json",
        "json": {
          "$subset": {
            "counts": {
              "$subset": {
                "raw": 1,
                "kept": 1,
                "reported": 1
              }
            },
            "completion": {
              "status": "partial"
            }
          }
        }
      },
      {
        "path": "CODE-REVIEW-*/evidence/coverage.json",
        "json": {
          "$subset": {
            "finders": {
              "$subset": {
                "dispatched": 2,
                "returned": 1,
                "invalid": [
                  "finder:local:01"
                ]
              }
            }
          }
        }
      }
    ],
    "side_effects": {
      "git": [
        {
          "repo": "workspace",
          "ref": "HEAD",
          "is": "{commit:1}"
        }
      ],
      "http": []
    },
    "providers": {
      "openrouter": {
        "consumed": {
          "$set": [
            "local-finder-bad",
            "local-finder-bad",
            "local-finder-bad",
            "rule-finder",
            "verify-escape"
          ]
        },
        "unmatched": 0,
        "requests": 5
      }
    },
    "interviews": {
      "questions": [],
