{
  "schema_version": 1,
  "id": "code-review/reverse-branch-completion",
  "family": "code-review",
  "title": "The first finder branch's answer is held back so the second branch finishes first; the fan-in still lists the envelopes in job order, the merge assigns each finding to its own job, and the report is identical to the in-order run.",
  "obligation": "code-review/reverse-branch-completion",
  "bundle": {
    "id": "code-review",
    "hash": "c43a461a05b2962cedd95b165430e3a21942ce8517a8e9d26024ed9ff4f22e8a"
  },
  "inputs": {
    "mode": "changes",
    "effort": "medium",
    "model": "kimi-k3",
    "range": "{commit:0}..{commit:1}",
    "expected_min_findings": "2"
  },
  "fixture": {
    "commits": [
      {
        "message": "base",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-base.py"
          },
          "AGENTS.md": {
            "file": "fixtures/AGENTS.md"
          }
        }
      },
      {
        "message": "change the pager and the title escaping",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-after.py"
          }
        }
      }
    ],
    "python_modules": [
      "yaml"
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "local-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:local:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 10, \"end_line\": 10, \"summary\": \"page_count drops the final partial page: floor division discards the remainder.\", \"short_summary\": \"Final partial page dropped\", \"failure_scenario\": \"7 items at page size 3 report 2 pages, so item 7 is unreachable.\", \"category\": \"correctness\", \"issue_type\": \"bug\", \"severity\": \"HIGH\", \"confidence\": \"HIGH\"}]}",
          "delay_before_headers_ms": 1500
        }
      },
      {
        "scenario_id": "rule-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:rule:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 15, \"end_line\": 15, \"summary\": \"render_title escapes the title twice.\", \"short_summary\": \"Title escaped twice\", \"failure_scenario\": \"A title containing & renders as &amp;amp;.\", \"category\": \"conventions\", \"issue_type\": \"style\", \"severity\": \"LOW\", \"confidence\": \"MEDIUM\", \"rule_id\": \"builtin:repository.instructions/agents-md-conventions\"}]}"
        }
      },
      {
        "scenario_id": "verify-pages",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F1\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"CONFIRMED\", \"reasoning\": \"src/app.py:10 uses floor division.\"}"
        }
      },
      {
        "scenario_id": "verify-escape",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F2\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"PLAUSIBLE\", \"reasoning\": \"src/app.py:14-15 escapes twice.\"}"
        }
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 180000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "prepare",
        "plan_finders",
        "finders",
        "finder",
        "finder_join",
        "merge_finders",
        "plan_verify",
        "verify",
        "verifier",
        "verify_join",
        "merge_verify",
        "tally",
        "final_tally",
        "render_report",
        "verify_expectations",
        "publish_pr"
      ],
      "forbidden_nodes": [
        "grouping",
        "sweeper"
      ],
      "visits": {
        "finder": 2,
        "verifier": 2
      }
    },
    "context": {
      "exact": {
        "finders_results_merged": 2,
        "reported_count": 2,
        "finding_count": 2
      },
      "absent": [
        "output.finder"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "CODE-REVIEW-*/evidence/findings.json",
        "json": [
          {
            "$subset": {
              "id": "R1",
              "line": 10,
              "reporters": [
                "finder:local:01"
              ]
            }
          },
          {
            "$subset": {
              "id": "R2",
              "line": 15,
              "reporters": [
                "finder:rule:01"
              ]
            }
          }
        ]
      },
      {
        "path": "CODE-REVIEW-*/evidence/coverage.json",
        "json": {
          "$subset": {
            "rejectedFindingReports": [],
            "finders": {
              "$subset": {
                "returned": 2,
                "invalid": []
              }
            }
          }
        }
      }
    ],
    "side_effects": {
      "git": [
        {
          "repo": "workspace",
          "ref": "HEAD",
          "is": "{commit:1}"
        }
      ],
      "http": []
    },
    "providers": {
      "openrouter": {
        "consumed": {
          "$set": [
            "local-finder",
            "rule-finder",
            "verify-pages",
            "verify-escape"
          ]
        },
        "unmatched": 0,
        "requests": 4
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
