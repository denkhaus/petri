{
  "schema_version": 1,
  "id": "code-review/no-surviving-findings",
  "family": "code-review",
  "title": "Two finders report findings and both verifiers refute them: the report carries zero findings, the ledger records both candidates as refuted, and a refuted finding never reaches the results.",
  "obligation": "code-review/no-surviving-findings",
  "bundle": {
    "id": "code-review",
    "hash": "c43a461a05b2962cedd95b165430e3a21942ce8517a8e9d26024ed9ff4f22e8a"
  },
  "inputs": {
    "mode": "changes",
    "effort": "medium",
    "model": "kimi-k3",
    "range": "{commit:0}..{commit:1}",
    "expected_min_findings": "0"
  },
  "fixture": {
    "commits": [
      {
        "message": "base",
        "write": {
          ".gitignore": {
            "text": "__pycache__/\n*.pyc\n"
          },
          "src/app.py": {
            "file": "fixtures/app-base.py"
          },
          "AGENTS.md": {
            "file": "fixtures/AGENTS.md"
          }
        }
      },
      {
        "message": "change the pager and the title escaping",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-after.py"
          }
        }
      }
    ],
    "python_modules": [
      "yaml"
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "local-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:local:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 10, \"end_line\": 10, \"summary\": \"page_count drops the final partial page: floor division discards the remainder.\", \"short_summary\": \"Final partial page dropped\", \"failure_scenario\": \"7 items at page size 3 report 2 pages, so item 7 is unreachable.\", \"category\": \"correctness\", \"issue_type\": \"bug\", \"severity\": \"HIGH\", \"confidence\": \"HIGH\"}]}"
        }
      },
      {
        "scenario_id": "rule-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:rule:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 15, \"end_line\": 15, \"summary\": \"render_title escapes the title twice.\", \"short_summary\": \"Title escaped twice\", \"failure_scenario\": \"A title containing & renders as &amp;amp;.\", \"category\": \"conventions\", \"issue_type\": \"style\", \"severity\": \"LOW\", \"confidence\": \"MEDIUM\", \"rule_id\": \"builtin:repository.instructions/agents-md-conventions\"}]}"
        }
      },
      {
        "scenario_id": "refute-pages",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F1\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"REFUTED\", \"reasoning\": \"src/app.py:8-9 rejects page_size <= 0, and callers pad the last page; the count is right.\"}"
        }
      },
      {
        "scenario_id": "refute-escape",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F2\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"REFUTED\", \"reasoning\": \"html.escape is idempotent on the already-escaped text in every caller.\"}"
        }
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 180000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "prepare",
        "plan_finders",
        "finders",
        "finder",
        "finder_join",
        "merge_finders",
        "plan_verify",
        "verify",
        "verifier",
        "verify_join",
        "merge_verify",
        "tally",
        "final_tally",
        "render_report",
        "verify_expectations",
        "publish_pr"
      ],
      "forbidden_nodes": [
        "grouping",
        "sweeper"
      ],
      "visits": {
        "finder": 2,
        "verifier": 2
      }
    },
    "context": {
      "exact": {
        "empty_target": false,
        "finders_results_merged": 2,
        "run_verify": true,
        "verify_results_merged": 2,
        "reported_count": 0,
        "finding_count": 0,
        "report_expectations_checked": true,
        "products_dir": {
          "$regex": "^CODE-REVIEW-\\d{8}-\\d{6}(-\\d+)?$"
        }
      },
      "absent": [
        "output.finder",
        "output.verifier"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "CODE-REVIEW-*/evidence/findings.json",
        "json": []
      },
      {
        "path": "CODE-REVIEW-*/evidence/review-manifest.json",
        "json": {
          "$subset": {
            "counts": {
              "deduplicated": 2,
              "duplicates": 0,
              "kept": 0,
              "raw": 2,
              "reported": 0,
              "sweep": 0
            },
            "completion": {
              "status": "complete"
            },
            "verification": {
              "status": "complete"
            }
          }
        }
      },
      {
        "path": "CODE-REVIEW-*/evidence/candidate-ledger.jsonl",
        "lines": 2
      },
      {
        "path": "CODE-REVIEW-*/evidence/candidate-ledger.jsonl",
        "contains": [
          "\"disposition\":\"refuted\""
        ]
      },
      {
        "path": "CODE-REVIEW-*/CODE-REVIEW-RESULTS.jsonl",
        "lines": 0
      },
      {
        "path": "CODE-REVIEW-*/evidence/candidate-ledger.jsonl",
        "contains": [
          "\"id\":\"F1\"",
          "\"id\":\"F2\""
        ]
      }
    ],
    "side_effects": {
      "git": [
        {
          "repo": "workspace",
          "ref": "HEAD",
          "is": "{commit:1}"
        }
      ],
      "http": []
    },
    "providers": {
      "openrouter": {
        "consumed": {
          "$set": [
            "local-finder",
            "rule-finder",
            "refute-pages",
            "refute-escape"
          ]
        },
        "unmatched": 0,
        "requests": 4
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
