{
  "schema_version": 1,
  "id": "code-review/multi-level-fan-out",
  "family": "code-review",
  "title": "Two levels of dynamic fan-out: two finder branches report three findings between them, plan_verify turns them into three verifier branches, every verdict lands on its own candidate, and the report carries all three in rank order.",
  "obligation": "code-review/multi-level-fan-out",
  "bundle": {
    "id": "code-review",
    "hash": "c43a461a05b2962cedd95b165430e3a21942ce8517a8e9d26024ed9ff4f22e8a"
  },
  "inputs": {
    "mode": "changes",
    "effort": "medium",
    "model": "kimi-k3",
    "range": "{commit:0}..{commit:1}",
    "expected_min_findings": "3"
  },
  "fixture": {
    "commits": [
      {
        "message": "base",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-base.py"
          },
          "AGENTS.md": {
            "file": "fixtures/AGENTS.md"
          }
        }
      },
      {
        "message": "change the pager and the title escaping",
        "write": {
          "src/app.py": {
            "file": "fixtures/app-after.py"
          }
        }
      }
    ],
    "python_modules": [
      "yaml"
    ]
  },
  "modes": {
    "backend": "host",
    "agent": "api:openrouter"
  },
  "services": {
    "openrouter": [
      {
        "scenario_id": "local-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:local:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 10, \"end_line\": 10, \"summary\": \"page_count drops the final partial page: floor division discards the remainder.\", \"short_summary\": \"Final partial page dropped\", \"failure_scenario\": \"7 items at page size 3 report 2 pages, so item 7 is unreachable.\", \"category\": \"correctness\", \"issue_type\": \"bug\", \"severity\": \"HIGH\", \"confidence\": \"HIGH\"}, {\"file\": \"src/app.py\", \"start_line\": 14, \"end_line\": 14, \"summary\": \"render_title strips before escaping, so surrounding whitespace is lost silently.\", \"short_summary\": \"Whitespace stripped silently\", \"failure_scenario\": \"A title of ' A ' renders as 'A' with no way to keep the padding.\", \"category\": \"correctness\", \"issue_type\": \"bug\", \"severity\": \"LOW\", \"confidence\": \"LOW\"}]}"
        }
      },
      {
        "scenario_id": "rule-finder",
        "matcher": {
          "input_contains": "\"job_id\": \"finder:rule:01\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"findings\": [{\"file\": \"src/app.py\", \"start_line\": 15, \"end_line\": 15, \"summary\": \"render_title escapes the title twice.\", \"short_summary\": \"Title escaped twice\", \"failure_scenario\": \"A title containing & renders as &amp;amp;.\", \"category\": \"conventions\", \"issue_type\": \"style\", \"severity\": \"LOW\", \"confidence\": \"MEDIUM\", \"rule_id\": \"builtin:repository.instructions/agents-md-conventions\"}]}"
        }
      },
      {
        "scenario_id": "verify-pages",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F1\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"CONFIRMED\", \"reasoning\": \"src/app.py:10 uses floor division.\"}"
        }
      },
      {
        "scenario_id": "verify-strip",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F2\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"PLAUSIBLE\", \"reasoning\": \"src/app.py:14 strips before escaping.\"}"
        }
      },
      {
        "scenario_id": "verify-escape",
        "matcher": {
          "input_contains": "\"job_id\": \"verify:F3\""
        },
        "script": {
          "kind": "success",
          "response_text": "{\"verdict\": \"CONFIRMED\", \"reasoning\": \"src/app.py:15 escapes an escaped string.\"}"
        }
      }
    ]
  },
  "interviews": [],
  "controls": {},
  "bounds": {
    "deadline_ms": 180000
  },
  "expect": {
    "process": {
      "exit_code": 0,
      "status": "success",
      "required_nodes": [
        "prepare",
        "plan_finders",
        "finders",
        "finder",
        "finder_join",
        "merge_finders",
        "plan_verify",
        "verify",
        "verifier",
        "verify_join",
        "merge_verify",
        "tally",
        "final_tally",
        "render_report",
        "verify_expectations",
        "publish_pr"
      ],
      "forbidden_nodes": [
        "grouping",
        "sweeper"
      ],
      "visits": {
        "finder": 2,
        "verifier": 3
      }
    },
    "context": {
      "exact": {
        "finders_results_merged": 2,
        "verify_jobs": {
          "$len": 3
        },
        "verify_results_merged": 3,
        "reported_count": 3,
        "finding_count": 3,
        "report_expectations_checked": true
      },
      "absent": [
        "output.finder",
        "output.verifier"
      ],
      "extra_allowed": [],
      "complete": false
    },
    "files": [
      {
        "path": "CODE-REVIEW-*/evidence/findings.json",
        "json": [
          {
            "$subset": {
              "id": "R1",
              "line": 10,
              "severity": "HIGH",
              "verdict": "CONFIRMED"
            }
          },
          {
            "$subset": {
              "id": "R2",
              "line": 14,
              "category": "correctness",
              "severity": "LOW",
              "verdict": "PLAUSIBLE"
            }
          },
          {
            "$subset": {
              "id": "R3",
              "line": 15,
              "category": "conventions",
              "verdict": "CONFIRMED"
            }
          }
        ]
      },
      {
        "path": "CODE-REVIEW-*/evidence/review-manifest.json",
        "json": {
          "$subset": {
            "counts": {
              "deduplicated": 3,
              "duplicates": 0,
              "kept": 3,
              "raw": 3,
              "reported": 3,
              "sweep": 0
            },
            "completion": {
              "status": "complete"
            }
          }
        }
      }
    ],
    "side_effects": {
      "git": [
        {
          "repo": "workspace",
          "ref": "HEAD",
          "is": "{commit:1}"
        }
      ],
      "http": []
    },
    "providers": {
      "openrouter": {
        "consumed": {
          "$set": [
            "local-finder",
            "rule-finder",
            "verify-pages",
            "verify-strip",
            "verify-escape"
          ]
        },
        "unmatched": 0,
        "requests": 5
      }
    },
    "interviews": {
      "questions": [],
      "errors": [],
      "consumed": {},
      "no_plaintext": []
    },
    "lifecycle": {
      "no_leaked_processes": true,
      "retained_workspace": true
    }
  }
}
