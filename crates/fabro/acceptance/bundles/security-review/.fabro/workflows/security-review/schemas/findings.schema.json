{
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "line",
          "ruleId",
          "identity",
          "severity",
          "difficulty",
          "confidence",
          "title",
          "rationale",
          "evidence",
          "snippet",
          "symbol",
          "impact",
          "exploitScenarios",
          "preconditions",
          "recommendations"
        ],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "ruleId": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^(?:auth-bypass|buffer-overflow|cleartext-transmission|code-injection|command-injection|credential-exposure|csrf|double-free|error-message-disclosure|fail-open|format-string|hardcoded-secret|header-injection|idor|improper-authorization|improper-input-validation|info-disclosure|insecure-deserialization|insecure-file-permissions|insufficient-logging|integer-overflow|key-nonce-reuse|log-injection|missing-authentication|null-dereference|open-redirect|out-of-bounds-read|out-of-bounds-write|path-traversal|privilege-escalation|prompt-injection|prototype-pollution|race-condition|redos|request-smuggling|resource-exhaustion|session-fixation|session-lifecycle|sql-injection|ssrf|supply-chain-integrity|template-injection|timing-side-channel|type-confusion|uninitialized-memory|unrestricted-file-upload|unsafe-configuration|use-after-free|user-enumeration|weak-authentication|weak-crypto|weak-randomness|workflow-bypass|xss|xxe)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "identity": {
            "type": "object",
            "required": ["anchor"],
            "additionalProperties": false,
            "properties": {
              "anchor": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "instance": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "difficulty": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "confidence": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence": {
            "type": ["array", "string"],
            "items": { "type": "string", "minLength": 1 }
          },
          "snippet": { "type": "string" },
          "symbol": { "type": "string" },
          "impact": { "type": "string" },
          "exploitScenarios": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "preconditions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommendations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "cweId": { "type": "string" }
        }
      }
    }
  }
}
