digraph SecurityReview {
    graph [
        goal="Perform an adversarial, read-only security review of this repository and report only panel-verified findings.",
        default_max_retries=0,
        default_fidelity="compact",
        on_failure="exit",
        stall_timeout="14400s",
        model_stylesheet="
            * { model: kimi-k3; reasoning_effort: low; }
            .inventory { model: kimi-k3; reasoning_effort: low; }
            .threat-model { model: kimi-k3; reasoning_effort: low; }
            .research { model: kimi-k3; reasoning_effort: high; }
            .verification { model: kimi-k3; reasoning_effort: high; }
            .dedupe { model: kimi-k3; reasoning_effort: high; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]
    prepare [
        shape=parallelogram,
        label="Resolve and size scan target",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.internal.run_id",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/security-review/scripts/security_review.py e86d0589908aac3844b8fcba0c233863f15f72026665a6833d2b368e747db7fc .fabro/workflows/security-review/scripts/git_readonly.py 9fb5ad5efb9164cded322a39e87680182711feba835fbec1fe8ea51fca993c34 .fabro/workflows/security-review/scripts/render_report.py c3edf58fde0883955355c79d98da80798285522e3e1c706c4a6d6d7afb616d52 .fabro/workflows/security-review/specs/report-spec.md baefbfd5970e734b4e05ce799e4613432ac81bb941708ddb7c53c9e6013646f4 .fabro/workflows/security-review/templates/report.html 666e2c0c28cb827fbc2113851c9aba5eea5a0c0d0e2eda0a9555cc375db23952 .fabro/workflows/security-review/schemas/taxonomy.json bde2b3caf394ccca1239a2a1a5b1cc98c109a74b9d15626d57af2d4e27cfbd10 && python3 .fabro/workflows/security-review/scripts/security_review.py prepare --scan-id-stdin --mode {{ inputs.mode }} --effort {{ inputs.effort }} --scope {{ inputs.scope }} --base {{ inputs.base }} --commit {{ inputs.commit }} --range {{ inputs.range }} --focus {{ inputs.focus }}"
    ]
    inventory [
        label="Inventory",
        class="inventory",
        prompt="@prompts/inventory.md.j2",
        output_schema="@schemas/inventory.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="3600s",
        project_memory=false,
        max_visits=3
    ]
    merge_inventory [
        shape=parallelogram,
        label="Merge inventory output",
        stdin_source="context.output.inventory",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge inventory",
        output_schema="routing",
        timeout="180s",
        max_visits=3
    ]
    inventory_failed [
        shape=parallelogram,
        label="Record inventory-failed fallback",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py inventory-failed"
    ]

    plan_matrix [
        shape=parallelogram,
        label="Plan component matrix",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py plan-matrix"
    ]
    threat_models [
        shape=component,
        label="Threat models",
        for_each="context.threat_jobs",
        max_parallel=12,
        on_failure="succeed"
    ]
    threat_model [
        label="Threat-model component",
        class="threat-model",
        prompt="@prompts/threat-model.md.j2",
        output_schema="@schemas/threat-model.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="7200s",
        project_memory=false
    ]
    threat_join [shape=tripleoctagon, label="Gather threat-model outputs"]
    merge_threat [
        shape=parallelogram,
        label="Merge threat-model outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge threat",
        output_schema="routing",
        timeout="180s"
    ]
    zip_cells [
        shape=parallelogram,
        label="Build research and sweep cells",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py zip-cells"
    ]

    research [
        shape=component,
        label="Research",
        for_each="context.research_jobs",
        max_parallel=24,
        on_failure="succeed"
    ]
    researcher [
        label="Research component and lens",
        class="research",
        prompt="@prompts/research.md.j2",
        output_schema="@schemas/findings.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="10800s",
        project_memory=false
    ]
    research_join [shape=tripleoctagon, label="Gather research outputs"]
    merge_research [
        shape=parallelogram,
        label="Merge research outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge research",
        output_schema="routing",
        timeout="180s"
    ]
    sweep [
        shape=component,
        label="Gap-fill sweeps",
        for_each="context.sweep_jobs",
        max_parallel=12,
        on_failure="succeed"
    ]
    sweeper [
        label="Gap-fill sweep",
        class="research",
        prompt="@prompts/sweep.md.j2",
        output_schema="@schemas/findings.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="10800s",
        project_memory=false
    ]
    sweep_join [shape=tripleoctagon, label="Gather sweep outputs"]
    merge_sweep [
        shape=parallelogram,
        label="Merge sweep outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge sweep",
        output_schema="routing",
        timeout="180s"
    ]

    dedup_rank [
        shape=parallelogram,
        label="Deduplicate, rank, and cap candidates",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py dedup-rank"
    ]
    panel [
        shape=component,
        label="Three-lens panel",
        for_each="context.verification_jobs",
        max_parallel=24,
        on_failure="succeed"
    ]
    panel_verifier [
        label="Verify candidate",
        class="verification",
        prompt="@prompts/verify.md.j2",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="7200s",
        project_memory=false
    ]
    panel_join [shape=tripleoctagon, label="Gather panel votes"]
    merge_panel [
        shape=parallelogram,
        label="Merge panel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge panel",
        output_schema="routing",
        timeout="180s"
    ]
    tally [
        shape=parallelogram,
        label="Tally initial panels",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py tally"
    ]

    repanel [
        shape=component,
        label="Repanel marginal keeps",
        for_each="context.repanel_jobs",
        max_parallel=24,
        on_failure="succeed"
    ]
    repanel_verifier [
        label="Recheck marginal candidate",
        class="verification",
        prompt="@prompts/verify.md.j2",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="7200s",
        project_memory=false
    ]
    repanel_join [shape=tripleoctagon, label="Gather repanel votes"]
    merge_repanel [
        shape=parallelogram,
        label="Merge repanel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge repanel",
        output_schema="routing",
        timeout="180s"
    ]
    adversarial_plan [
        shape=parallelogram,
        label="Apply repanel and plan red-team round",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py adversarial-plan"
    ]

    redteam [
        shape=component,
        label="Red-team every survivor",
        for_each="context.redteam_jobs",
        max_parallel=24,
        on_failure="succeed"
    ]
    redteam_verifier [
        label="Red-team candidate",
        class="verification",
        prompt="@prompts/redteam.md.j2",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="10800s",
        project_memory=false
    ]
    redteam_join [shape=tripleoctagon, label="Gather red-team votes"]
    merge_redteam [
        shape=parallelogram,
        label="Merge red-team votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge redteam",
        output_schema="routing",
        timeout="180s"
    ]

    dedupe_plan [
        shape=parallelogram,
        label="Plan duplicate scan over verified findings",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py dedupe-plan"
    ]
    dedupe [
        label="De-duplicate verified findings",
        class="dedupe",
        prompt="@prompts/dedupe.md.j2",
        output_schema="@schemas/dedupe.schema.json",
        output_retries=2,
        max_retries=2,
        on_failure="succeed",
        timeout="7200s",
        project_memory=false
    ]
    merge_dedupe [
        shape=parallelogram,
        label="Merge duplicate-scan verdicts",
        stdin_source="context.output.dedupe",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge dedupe",
        output_schema="routing",
        timeout="180s"
    ]

    final_tally [
        shape=parallelogram,
        label="Write completed canonical scan bundle",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py final-tally"
    ]
    render_report [
        shape=parallelogram,
        label="Derive Markdown, HTML, JSONL, and revision metadata",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py render-report"
    ]
    verify_expectations [
        shape=parallelogram,
        label="Verify configured report expectations",
        timeout="30s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py verify-expectations --expected-count '{{ inputs.expected_finding_count }}' --expected-rule-id '{{ inputs.expected_rule_id }}'"
    ]

    start -> prepare
    prepare -> exit [condition="outcome=succeeded && context.empty_target=true"]
    prepare -> inventory [condition="outcome=succeeded && context.empty_target=false && context.use_inventory=true"]
    prepare -> plan_matrix

    inventory -> inventory_failed [condition="outcome!=succeeded"]
    inventory -> merge_inventory
    inventory_failed -> plan_matrix
    merge_inventory -> inventory [condition="outcome=succeeded && context.inventory_correction=true"]
    merge_inventory -> plan_matrix

    plan_matrix -> threat_models [condition="outcome=succeeded && context.run_threat_models=true"]
    plan_matrix -> research [condition="outcome=succeeded && context.run_threat_models=false && context.run_research=true"]
    plan_matrix -> sweep [condition="outcome=succeeded && context.run_threat_models=false && context.run_research=false && context.run_sweeps=true"]
    plan_matrix -> dedup_rank
    threat_models -> threat_model [fidelity="truncate"]
    threat_model -> threat_join -> merge_threat
    merge_threat -> zip_cells
    zip_cells -> research [condition="outcome=succeeded && context.run_research=true"]
    zip_cells -> sweep [condition="outcome=succeeded && context.run_research=false && context.run_sweeps=true"]
    zip_cells -> dedup_rank

    research -> researcher [fidelity="truncate"]
    researcher -> research_join -> merge_research
    merge_research -> sweep [condition="outcome=succeeded && context.run_sweeps=true"]
    merge_research -> dedup_rank

    sweep -> sweeper [fidelity="truncate"]
    sweeper -> sweep_join -> merge_sweep
    merge_sweep -> dedup_rank

    dedup_rank -> panel [condition="outcome=succeeded && context.run_panel=true"]
    dedup_rank -> tally
    panel -> panel_verifier [fidelity="truncate"]
    panel_verifier -> panel_join -> merge_panel
    merge_panel -> tally

    tally -> repanel [condition="outcome=succeeded && context.max_effort=true && context.run_repanel=true"]
    tally -> adversarial_plan [condition="outcome=succeeded && context.max_effort=true && context.run_repanel=false"]
    tally -> dedupe_plan
    repanel -> repanel_verifier [fidelity="truncate"]
    repanel_verifier -> repanel_join -> merge_repanel
    merge_repanel -> adversarial_plan

    adversarial_plan -> redteam [condition="outcome=succeeded && context.run_redteam=true"]
    adversarial_plan -> dedupe_plan
    redteam -> redteam_verifier [fidelity="truncate"]
    redteam_verifier -> redteam_join -> merge_redteam
    merge_redteam -> dedupe_plan

    dedupe_plan -> dedupe [condition="outcome=succeeded && context.run_dedupe=true"]
    dedupe_plan -> final_tally
    dedupe -> merge_dedupe [condition="outcome=succeeded"]
    dedupe -> final_tally
    merge_dedupe -> final_tally

    final_tally -> render_report
    render_report -> verify_expectations
    verify_expectations -> exit
}
