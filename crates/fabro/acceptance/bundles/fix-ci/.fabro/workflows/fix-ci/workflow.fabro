digraph FixCI {
    graph [
        goal="Fix deterministic CI failures on {{ inputs.target }} in {{ inputs.target_repository }} and update the existing branch",
        rankdir=LR,
        max_node_visits=20,
        retry_target=exit
    ]

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    checkout [
        shape=parallelogram,
        label="Check out target branch",
        script="python3 .fabro/workflows/fix-ci/scripts/fix_ci.py checkout --repository \"{{ inputs.target_repository }}\" --target \"{{ inputs.target }}\"",
        output_schema="routing",
        timeout="10m",
        goal_gate=true
    ]

    setup [
        shape=parallelogram,
        label="Install target dependencies",
        script="cd .fabro/workflows/fix-ci/runtime/target && node --version 2>&1 && node --version | grep -qx v$(cat .node-version) && corepack enable 2>&1 && yarn --version 2>&1 && git --version 2>&1 && yarn install --immutable 2>&1 && cd node_modules/rxdb-premium && node ./scripts/postinstall.js 2>&1 && node ./scripts/installer.js 2>&1",
        timeout="40m",
        goal_gate=true
    ]

    verify [
        shape=parallelogram,
        label="Run deterministic target CI checks",
        script="python3 .fabro/workflows/fix-ci/scripts/fix_ci.py check",
        timeout="60m",
        goal_gate=true,
        retry_target="fix",
        max_visits=5
    ]

    fix [
        label="Fix target CI failures",
        model="gpt-sol",
        reasoning_effort="high",
        prompt="@prompts/fix.md.j2",
        max_visits=4
    ]

    lint_fix [
        shape=parallelogram,
        label="Run required target lint fix",
        script="python3 .fabro/workflows/fix-ci/scripts/fix_ci.py lint-fix",
        timeout="40m",
        goal_gate=true,
        retry_target="fix",
        max_visits=4
    ]

    final_verify [
        shape=parallelogram,
        label="Re-run deterministic target CI checks",
        script="python3 .fabro/workflows/fix-ci/scripts/fix_ci.py check",
        timeout="60m",
        goal_gate=true,
        retry_target="fix",
        max_visits=4
    ]

    publish [
        shape=parallelogram,
        label="Commit and push existing target branch",
        script="python3 .fabro/workflows/fix-ci/scripts/fix_ci.py publish",
        timeout="10m",
        goal_gate=true
    ]

    start -> checkout
    checkout -> setup [condition="outcome=succeeded"]
    checkout -> exit
    setup -> verify [condition="outcome=succeeded"]
    setup -> exit
    verify -> lint_fix [condition="outcome=succeeded"]
    verify -> fix
    fix -> verify [condition="outcome=succeeded"]
    fix -> exit
    lint_fix -> final_verify [condition="outcome=succeeded"]
    lint_fix -> fix
    final_verify -> publish [condition="outcome=succeeded"]
    final_verify -> fix
    publish -> exit
}
